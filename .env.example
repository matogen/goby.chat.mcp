# Optional. Environment variables override every stored token.
# Prefer per-project tokens instead:
#   goby-mcp token set gk_... --base-url https://<team>.goby.chat --dir /path/to/project
#   (or the set-project-token tool from inside Claude Code)
#GOBY_BASE_URL=https://<team>.goby.chat
#GOBY_API_KEY=gk_xxx_yyy
# Where tokens are stored (default ~/.config/goby-mcp/config.json)
#GOBY_MCP_CONFIG=
